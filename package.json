{
    "name": "givar",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "clean": "turbo run clean && rm -rf node_modules",
        "test": "turbo run test",

        "// --- DATABASE COMMANDS ---": "",
        "db:generate": "turbo run db:generate",
        "db:push": "turbo run db:push",
        "db:push:force": "pnpm --filter @givar/database db:push:force",
        "db:studio": "pnpm --filter @givar/database db:studio",
        "db:seed": "pnpm --filter @givar/database db:seed",

        "// --- SHORTCUTS ---": "",
        "dev:api": "pnpm --filter api dev",
        "dev:web": "pnpm --filter web dev",
        "dev:db": "pnpm --filter @givar/database dev"
    },
    "devDependencies": {
        "turbo": "^2.0.0",
        "prettier": "^3.0.0",
        "eslint": "^8.0.0",
        "typescript": "^5.7.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "packageManager": "pnpm@9.0.0",
    "pnpm": {
        "overrides": {
            "react": "19.0.0",
            "react-dom": "19.0.0",
            "@types/react": "19.0.0",
            "@types/react-dom": "19.0.0",
            "@types/node": "^22.0.0"
        }
    }
}