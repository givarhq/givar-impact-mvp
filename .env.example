# -----------------------------------------------------------------------------
# GIVAR API - ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# --- APP CONFIG ---
NODE_ENV=development # Options: development, production, test
PORT=3001
FRONTEND_URL=http://localhost:3000

# --- DATABASE (Neon.tech) ---
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- AUTHENTICATION (JWT) ---
# Generate long random strings for these (e.g., openssl rand -base64 32)
JWT_SECRET=your_ultra_secure_access_token_secret
JWT_REFRESH_SECRET=your_ultra_secure_refresh_token_secret

# --- PAYMENTS (Paystack) ---
# Get these from your Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- EMAIL (Resend) ---
# Get your API Key at resend.com. 
# FROM_EMAIL must be a verified domain in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Givar Impact <impact@your-verified-domain.com>

# --- STORAGE (iDrive e2 / S3 Compatible) ---
# Get these from your iDrive e2 "Access Keys" and "Buckets" sections
IDRIVE_BUCKET=givar-assets
IDRIVE_REGION=eu-west-3
IDRIVE_ENDPOINT=https:s3.eu-west-3.idrivee2.com
IDRIVE_ACCESS_KEY_ID=your_idrive_access_key
IDRIVE_SECRET_ACCESS_KEY=your_idrive_secret_key

# -----------------------------------------------------------------------------
# NOTE: Copy this file to .env and fill in the actual values.
# NEVER commit your actual .env file to version control.
# -----------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------------------------------------------------------------------------
#Pro-Tips:
#1.  JWT Secrets: Use a tool or command line (`openssl rand -base64 32`) to generate the secrets for production.

#2.  Database URL: If using Neon, ensure `?sslmode=require` is at the end of the string to avoid connection errors in production.

#3.  Paystack: Use the `sk_test_` keys for local development to avoid charging real money.

#4.  Monorepo Environment Sync: Because this is a monorepo, environment variables are consumed in multiple places. If you have not set up a global environment injector, you must duplicate the .env file into the following directories:

    #apps/api/.env (For the NestJS backend logic)

    #apps/web/.env.local (For the Next.js frontend logic)

    #packages/database/.env (Critical for Prisma migrations and pnpm db:push)
# ----------------------------------------------------------------------------------------------------------------------------------------------------------