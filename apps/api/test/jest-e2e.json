{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".e2e-spec.ts$",
    "transform": {
        "^.+\\.[tj]s$": [
            "ts-jest",
            {
                "tsconfig": {
                    "allowJs": true,
                    "esModuleInterop": true
                }
            }
        ]
    },
    "transformIgnorePatterns": [
        "/node_modules/(?!.*(@scure|@noble|otplib|@otplib|axios))"
    ],
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/../src/$1"
    }
}