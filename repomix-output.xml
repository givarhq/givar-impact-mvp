const KPICard = memo(function KPICard({ title, value, subValue, icon: Icon, color, bg, isRawValue = false, delay = 0 }: any) {
    return (
        <motion.div
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.3, delay }}
