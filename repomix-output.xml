                    />
                    <Input
                      label="Representative contact number"
                      placeholder="Direct contact number"
                      value={contactPhone || ''}
                      onChange={(e) => updateField('contactPhone', e.target.value)}
                      className="h-12 rounded-2xl bg-card border-border/60 focus:bg-background"
                    />
