<file path="packages/database/prisma/schema.prisma">
generator client {
  provider        = "prisma-client-js"
  engineType      = "library" 
}

datasource db {
  provider = "postgresql"
}

// ---------------------------
// ENUMS
// ---------------------------

enum Currency {
  NGN
  USD
  GBP
}

enum TxType {
  DEBIT   // Money leaving a wallet
  CREDIT  // Money entering a wallet
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  SUSPENSE
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum AccountType {
  INDIVIDUAL
  ORGANIZER
}

enum KycType {
  INDIVIDUAL
  ORGANIZATION
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum SubscriptionInterval {
  WEEKLY
  MONTHLY
}

enum GoalInterval {
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  FUNDED
  COMPLETED
  SUSPENDED
}

enum UpdateType {
  MILESTONE
  ANNOUNCEMENT
  IMPACT_REPORT
}

enum AuditAction {
  // Auth
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_REGISTER
  PASSWORD_CHANGE
  RESET_REQUESTED
  RESET_SUCCESSFUL
  ACCOUNT_TYPE_CHANGED
  PROFILE_UPDATED
  AVATAR_UPDATED
  ACCOUNT_DELETED

  // 2FA Actions
  TWO_FACTOR_GEN_SECRET
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_VERIFY_FAILED

  // Security Overrides
  USER_LOCKED
  USER_UNLOCKED
  USER_ROLE_CHANGED
  IMPERSONATION_STARTED
  
  // Financial
  WALLET_FUND
  WALLET_DEBIT
  DONATION_CREATED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_UPDATED
  DIRECT_PAYMENT_INITIATED
  DIRECT_PAYMENT_FULFILLED
  WEBHOOK_SIGNATURE_FAILED
  WALLET_FUND_SUCCESS
  RECONCILIATION_PERFORMED
  FUNDS_MOVED_TO_SUSPENSE
  DISBURSEMENT_RECORDED
  FUNDS_REALLOCATED
  TRANSACTION_RESOLVED
  RECEIPT_VIEWED
  
  // Project/Admin
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  PROJECT_SUSPENDED
  PROPOSAL_REJECTED
  MILESTONE_PROOF_SUBMITTED
  USER_VERIFIED
  USER_REJECTED
  MESSAGE_SENT
  
  // System
  WEBHOOK_RECEIVED

  // Discovery & Recommendation System
  RECOMMENDATION_CONFIG_UPDATED
  FEATURED_SLOT_CREATED
  FEATURED_SLOT_DELETED
  CATEGORY_WEIGHT_UPDATED
  PROJECT_DISCOVERY_WEIGHTS_UPDATED

  // Fee Governance
  FEE_RULE_CREATED
  FEE_RULE_DEACTIVATED
}

enum ProposalStatus {
  DRAFT             // User is still writing
  SUBMITTED         // Locked, waiting for admin
  AWAITING_VERIFICATION // Waiting for verification
  UNDER_REVIEW      // Admin is actively investigating
  CHANGES_REQUESTED // Sent back to user for edits
  APPROVED          // Promoted to live Project
  REJECTED          // Final decision, dead end
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationStatus {
  APPROVED
  FLAGGED
  HIDDEN
}

enum NotificationType {
  SYSTEM
  MESSAGE
  PROJECT_STATUS
  KYC_STATUS
  PROPOSAL_STATUS
  MILESTONE_ALERT
  DONATION_RECEIVED
}

// ---------------------------
// USER & AUTH
// ---------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(USER)
  avatarKey     String?

  twoFactorSecret  String?   // Encrypted TOTP secret
  twoFactorEnabled Boolean   @default(false)

  preferences      Json?     @default("{}")
  
  emailVerified         Boolean     @default(false)
  emailVerificationToken String?    @unique
  organization   OrganizationProfile?
  accountType   AccountType @default(INDIVIDUAL)
  
  resetPasswordTokenHash String?    @unique
  resetPasswordExpiresAt DateTime?

  failedLoginAttempts   Int         @default(0)
  accountLockedUntil    DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  wallets       Wallet[]
  donations     Donation[]
  subscriptions Subscription[]
  givingGoals   GivingGoal[]
  auditLogs     AuditLog[]
  projectProposals ProjectProposal[]
  projects      Project[]
  sentMessages Message[] @relation("Author")
  notifications Notification[]
  createdFeeRules TransactionFeeRule[]

  @@map("users")
}

// ---------------------------
// FINANCIAL LEDGER CORE
// ---------------------------

model Wallet {
  id          String    @id @default(uuid())
  userId      String
  currency    Currency
  
  // CAUTION: This is a read-optimization snapshot.
  // The Source of Truth is the sum of WalletTransactions.
  balance     BigInt    @default(0) 
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  user         User                 @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  // Constraint: One wallet per currency per user
  @@unique([userId, currency]) 
  @@map("wallets")
  version     Int       @default(0) // For Optimistic Concurrency Control
}

// The Immutable Ledger
model WalletTransaction {
  id              String    @id @default(uuid())
  walletId        String
  
  // Amounts are always positive absolute values in storage.
  // 'type' determines the arithmetic direction.
  amount          BigInt    
  currency        Currency
  
  type            TxType
  status          TxStatus  @default(PENDING)
  
  reference       String    @unique
  description     String?
  metadata        Json?     // Audit logs (IP, UserAgent)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  wallet      Wallet    @relation(fields: [walletId], references: [id])
  donation    Donation? 

  @@index([walletId])
  @@index([reference])
  @@map("wallet_transactions")
}

// ---------------------------
// GIVAR IMPACT (PROJECTS)
// ---------------------------

model Project {
  id          String   @id @default(uuid())
  proposalId    String?  @unique 
  slug        String   @unique 
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title       String
  description String  
  shortDesc   String? 
  imageUrl      String?  // Main Hero Image
  gallery       Json?    @default("[]")

  targetAmount BigInt
  raisedAmount BigInt   @default(0)
  currency     Currency
  status        ProjectStatus @default(ACTIVE)

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  tags          String[]  // Simple array for "Urgent", "Verified", etc.

  location      String?   // "Lagos, Nigeria"
  
  updates       ProjectUpdate[]

  donorCount    Int      @default(0)
  endDate       DateTime?
  
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  budgetBreakdown   Json?    @default("[]")
  executionTimeline Json?    @default("[]")
  fundedAt      DateTime?
  riskAnalysis      String?  @db.Text

  donations    Donation[]
  subscriptions Subscription[]
  guestDonations GuestDonation[]
  disbursements  Disbursement[]
  milestoneProofs MilestoneProof[]

  moderationStatus  ModerationStatus @default(APPROVED)
  isFeatured        Boolean          @default(false)
  featureWeight     Int              @default(0)
  visibilityScore   Float            @default(0.0)
  featuredSlots     FeaturedSlot[]
  messages Message[]

  @@map("projects")
  @@index([categoryId])
  @@index([status])
}

model ProjectUpdate {
  id          String     @id @default(uuid())
  projectId   String
  title       String
  content     String     @db.Text
  type        UpdateType @default(ANNOUNCEMENT)
  imageUrl    String?
  
  createdAt   DateTime   @default(now())
  
  project     Project    @relation(fields: [projectId], references: [id])

  @@map("project_updates")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique // e.g. "Education", "Health"
  slug        String    @unique
  description String?
  icon        String?   // Lucide icon name or emoji

  visibilityWeight Float  @default(1.0)
  
  projects    Project[]
  proposals ProjectProposal[]

  @@map("categories")
}

model Donation {
  id            String   @id @default(uuid())
  userId        String?
  projectId     String
  transactionId String   @unique // Strict link to ledger

  amount        BigInt   // Total charged to the user
  currency      Currency
  message       String?  

  // Financial Split (Snapshot)
  baseAmount         BigInt    @default(0) // What the project actually receives
  feePercentageUsed  Float     @default(0) // Snapshot of the percentage (e.g., 2.5)
  feeAmount          BigInt    @default(0) // The exact cut taken by platform
  tipAmount          BigInt    @default(0) // Optional donor tip to platform

  createdAt     DateTime @default(now())

  // Relationships
  user        User?              @relation(fields:[userId], references: [id])
  project     Project           @relation(fields: [projectId], references: [id])
  transaction WalletTransaction @relation(fields: [transactionId], references: [id])
  
  feeRuleId          String?
  feeRule            TransactionFeeRule? @relation(fields: [feeRuleId], references: [id])

  @@map("donations")
}

model GuestDonor {
  id            String          @id @default(uuid())
  email         String          @unique // normalized
  name          String?         
  totalDonated  BigInt          @default(0)
  donationCount Int             @default(0)
  firstDonated  DateTime        @default(now())
  lastDonated   DateTime        @updatedAt

  donations     GuestDonation[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([email])
  @@map("guest_donors")
}

model GuestDonation {
  id            String       @id @default(uuid())
  
  guestDonorId  String
  reference     String       @unique
  projectId     String
  
  amount        BigInt       // Total charged to the user
  currency      Currency
  message       String?
  
  // Financial Split (Snapshot)
  baseAmount         BigInt    @default(0)
  feePercentageUsed  Float     @default(0)
  feeAmount          BigInt    @default(0)
  tipAmount          BigInt    @default(0)

  status        TxStatus     @default(COMPLETED)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  guestDonor    GuestDonor   @relation(fields: [guestDonorId], references:[id])
  project       Project      @relation(fields: [projectId], references: [id])

  feeRuleId          String?
  feeRule            TransactionFeeRule? @relation(fields: [feeRuleId], references: [id])

  @@index([guestDonorId])
  @@index([projectId])
  @@index([reference])
  @@map("guest_donations")
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  projectId       String
  
  amount          BigInt   // Amount per interval
  currency        Currency
  interval        SubscriptionInterval
  status          SubscriptionStatus @default(ACTIVE)

  nextChargeDate  DateTime
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  project     Project   @relation(fields: [projectId], references: [id])

  @@map("subscriptions")
}

model GivingGoal {
  id            String       @id @default(uuid())
  userId        String
  
  targetAmount  BigInt
  currency      Currency
  interval      GoalInterval
  status        GoalStatus   @default(ACTIVE)

  startDate     DateTime
  endDate       DateTime
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id])

  // Constraint: A user can only have one active goal of a certain type at a time.
  @@unique([userId, interval, status])
  @@map("giving_goals")
}

model AuditLog {
  id            String      @id @default(uuid())
  userId        String?     // Nullable for system events or failed logins
  action        AuditAction
  
  // Target Resource (What was touched?)
  entityId      String?     
  entityType    String?     // e.g., "Project", "Wallet", "User"
  
  // Context
  metadata      Json?       // Stores { before: ..., after: ... } or details
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime    @default(now())

  // Relationships
  user          User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityId])
  @@map("audit_logs")
}

model ProjectProposal {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])

  // --- 1. The Hook  ---
  title         String?
  shortDesc     String?
  description   String?         @db.Text
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id])
  location      String?
  beneficiaryContact String?
  targetAmount  BigInt?         
  currency      Currency        @default(NGN)

  // --- 2. The Evidence  ---
  coverImage    String?
  gallery       Json?    @default("[]")
  videoUrl      String?

  // --- 3. The Execution Plan ---
  // JSON Structure: 
  // [
  //   { item: "Borehole Drilling", cost: 800000, vendor: "ABC Drilling Ltd", vendorContact: "080...", type: "SERVICE" },
  //   { item: "Water Tank (2000L)", cost: 150000, vendor: "Jumia/Market", type: "GOODS" }
  // ]
  budgetBreakdown Json?
  
  executionTimeline Json?
  riskAnalysis      String?      @db.Text

  // --- 4. The Trust (Identity Only) ---
  // KYC: to verify the Proposer is real and distinct from the Vendors to prevent kickback fraud.
  kycDocuments      String[]     
  organizationName  String?
  contactPhone      String?

  // --- 5. State Machine ---
  status        ProposalStatus  @default(DRAFT)
  adminFeedback String?         @db.Text 
  reviewedBy    String?         
  submittedAt   DateTime?
  approvedAt    DateTime?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages Message[]

  @@index([userId])
  @@index([status])
  @@map("project_proposals")
}

model OrganizationProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])

  kycType            KycType            @default(ORGANIZATION)
  
  legalName          String
  registrationNumber String?            // e.g., RC Number
  documentKeys       String[]           // S3 keys for CAC, Tax IDs, etc.
  
  status             VerificationStatus @default(NOT_SUBMITTED)
  adminFeedback      String?            @db.Text
  verifiedAt         DateTime?
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("organization_profiles")
}

model Disbursement {
  id              String   @id @default(uuid())
  projectId       String
  milestoneId     String   // Linked to the phase in executionTimeline
  
  amount          BigInt
  currency        Currency
  vendorName      String
  reference       String   @unique // Internal or Bank Ref
  receiptKey      String?  
  
  createdAt       DateTime @default(now())
  
  project         Project  @relation(fields: [projectId], references: [id])

  @@map("disbursements")
}

model MilestoneProof {
  id            String   @id @default(uuid())
  projectId     String
  milestoneId   String
  
  description   String   @db.Text
  imageKeys     String[] // S3 keys for the proof photos
  
  status        ProofStatus @default(PENDING)
  adminFeedback String?     @db.Text
  
  submittedAt   DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  project       Project  @relation(fields: [projectId], references: [id])

  @@map("milestone_proofs")
}

model RecommendationConfig {
  id                 String   @id @default("default")
  recencyWeight      Float    @default(5.0)
  velocityWeight     Float    @default(7.0)
  engagementWeight   Float    @default(3.0)
  adminWeight        Float    @default(4.0)
  diversityLimit     Int      @default(3)
  showFundedProjects Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  @@map("recommendation_configs")
}

model FeaturedSlot {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  position  Int      @unique
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@map("featured_slots")
}

model Message {
  id          String   @id @default(uuid())
  content     String   @db.Text
  
  // The person who wrote the message
  authorId    String
  author      User     @relation("Author", fields: [authorId], references: [id])
  
  // Context: Is this about a proposal or a live project?
  proposalId  String?
  proposal    ProjectProposal? @relation(fields: [proposalId], references: [id])
  
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])

  // Metadata
  isAdmin     Boolean  @default(false) // Was this sent by Givar Admin?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("messages")
  @@index([proposalId])
  @@index([projectId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      NotificationType
  title     String
  content   String           @db.Text
  link      String?          // The relative path to navigate to when clicked
  
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
  @@index([userId])
  @@index([createdAt])
}

model TransactionFeeRule {
  id                 String    @id @default(uuid())
  percentage         Float     // e.g. 2.5
  appliesGlobally    Boolean   @default(true)
  categoryId         String?   // Overrides global rule for specific sectors
  optionalTipEnabled Boolean   @default(true)

  activeFrom         DateTime  @default(now())
  activeUntil        DateTime? // Null if currently active

  createdById        String
  creator            User      @relation(fields: [createdById], references: [id])

  isActive           Boolean   @default(true)

  donations          Donation[]
  guestDonations     GuestDonation[]

  @@index([activeFrom, activeUntil])
  @@index([categoryId])
  @@map("transaction_fee_rules")
}
</file>

<file path="packages/database/prisma/seed.ts">
import 'dotenv/config';
import {
  Currency, ProjectStatus, UserRole, ProposalStatus,
  VerificationStatus, AccountType, TxType, TxStatus,
  SubscriptionInterval, SubscriptionStatus, GoalInterval,
  GoalStatus, AuditAction, ProofStatus
} from '@prisma/client';
import * as bcrypt from 'bcrypt';
import { randomUUID } from 'crypto';
import { subDays, addDays } from 'date-fns';
import { prisma } from '../src/index';

async function main() {
  console.log('🚀 Launching Optimized Forensic Seed (High-Capital Velocity & Professional Naming)...');

  // 1. CLEANUP
  console.log('🧹 Purging ledger...');
  await prisma.auditLog.deleteMany({});
  await prisma.milestoneProof.deleteMany({});
  await prisma.disbursement.deleteMany({});
  await prisma.projectUpdate.deleteMany({});
  await prisma.donation.deleteMany({});
  await prisma.guestDonation.deleteMany({});
  await prisma.guestDonor.deleteMany({});
  await prisma.subscription.deleteMany({});
  await prisma.givingGoal.deleteMany({});
  await prisma.project.deleteMany({});
  await prisma.projectProposal.deleteMany({});
  await prisma.organizationProfile.deleteMany({});
  await prisma.walletTransaction.deleteMany({});
  await prisma.wallet.deleteMany({});
  await prisma.category.deleteMany({});
  await prisma.user.deleteMany({});

  const salt = await bcrypt.genSalt(10);
  const adminPass = await bcrypt.hash('Givartech1$', salt);
  const userPass = await bcrypt.hash('Password1', salt);

  // 2. REALISTIC TAXONOMY (10 Categories)
  const categories = await Promise.all([
    prisma.category.create({ data: { name: 'Clean Water & Sanitation', slug: 'water', icon: 'Droplets' } }),
    prisma.category.create({ data: { name: 'Quality Education', slug: 'education', icon: 'Book' } }),
    prisma.category.create({ data: { name: 'Healthcare Access', slug: 'health', icon: 'Heart' } }),
    prisma.category.create({ data: { name: 'Sustainable Agriculture', slug: 'agriculture', icon: 'Sprout' } }),
    prisma.category.create({ data: { name: 'Emergency Relief', slug: 'emergency', icon: 'Shield' } }),
    prisma.category.create({ data: { name: 'Climate Action', slug: 'climate', icon: 'Leaf' } }),
    prisma.category.create({ data: { name: 'Animal Welfare', slug: 'animals', icon: 'PawPrint' } }),
    prisma.category.create({ data: { name: 'Tech for Impact', slug: 'tech', icon: 'Cpu' } }),
    prisma.category.create({ data: { name: 'Arts & Youth Culture', slug: 'arts', icon: 'Palette' } }),
    prisma.category.create({ data: { name: 'Community Infrastructure', slug: 'community', icon: 'Building' } }),
  ]);

  // Optimized Stock Images (w=800, q=60)
  const photoParams = '?auto=format&fit=crop&q=60&w=800';
  const stockPhotos = [
    `https://images.unsplash.com/photo-1542601906990-b4d3fb778b09${photoParams}`,
    `https://images.unsplash.com/photo-1497633762265-9d179a990aa6${photoParams}`,
    `https://images.unsplash.com/photo-1584622650111-993a426fbf0a${photoParams}`,
    `https://images.unsplash.com/photo-1500651230702-0e2d8a49d4ad${photoParams}`,
    `https://images.unsplash.com/photo-1469571483398-62ff14bc03e0${photoParams}`,
    `https://images.unsplash.com/photo-1473081556163-2a1713ff9775${photoParams}`,
    `https://images.unsplash.com/photo-1591768793355-74d7c526cc15${photoParams}`,
    `https://images.unsplash.com/photo-1550751827-4bd374c3f58b${photoParams}`,
    `https://images.unsplash.com/photo-1460518451285-97b6aa326961${photoParams}`,
    `https://images.unsplash.com/photo-1531206715517-5c0ba140b2b8${photoParams}`,
  ];

  const projectNouns = ['Initiative', 'Project', 'Drive', 'Fund', 'Mission', 'Hub', 'Action', 'Relief', 'Development', 'Grant'];

  // 3. USERS
  const adminUser = await prisma.user.create({
    data: { email: 'admin@givar.com', firstName: 'Givar', lastName: 'Admin', passwordHash: adminPass, role: UserRole.SUPERADMIN, emailVerified: true, accountType: AccountType.INDIVIDUAL, createdAt: subDays(new Date(), 60) }
  });

  const tedUser = await prisma.user.create({
    data: { email: 'tedunjaiyem@gmail.com', firstName: 'Matthew', lastName: 'Tedunjaiye', passwordHash: userPass, role: UserRole.USER, emailVerified: true, accountType: AccountType.ORGANIZER, createdAt: subDays(new Date(), 45) }
  });

  const testUser = await prisma.user.create({
    data: { email: 'test@givar.com', firstName: 'Test', lastName: 'Giver', passwordHash: userPass, role: UserRole.USER, emailVerified: true, accountType: AccountType.INDIVIDUAL, createdAt: subDays(new Date(), 30) }
  });

  const backgroundDonors = [];
  for (let i = 0; i < 15; i++) {
    backgroundDonors.push(await prisma.user.create({
      data: { email: `donor${i}@example.com`, firstName: `Donor_${i}`, lastName: 'Verified', passwordHash: userPass, createdAt: subDays(new Date(), Math.floor(Math.random() * 40)) }
    }));
  }

  // 4. WALLETS (Starting with 10M NGN for donors to afford high velocity)
  await prisma.wallet.create({ data: { userId: adminUser.id, currency: Currency.NGN, balance: 0n } });
  await prisma.wallet.create({ data: { userId: tedUser.id, currency: Currency.NGN, balance: 0n } });

  const donorWallets = [];
  for (const donor of [...backgroundDonors, testUser]) {
    donorWallets.push(await prisma.wallet.create({
      data: { userId: donor.id, currency: Currency.NGN, balance: 1000000000n }
    }));
  }

  // 5. MATTHEW'S ORG PROFILE
  await prisma.organizationProfile.create({
    data: { userId: tedUser.id, legalName: 'Ted Impact Ventures', registrationNumber: 'RC-TED-2024', status: VerificationStatus.VERIFIED, verifiedAt: subDays(new Date(), 35) }
  });

  // 6. 10 PROPOSALS (Matthew)
  console.log('📥 Seeding 10 Proposals for Matthew...');
  const propStatuses = [
    ProposalStatus.DRAFT, ProposalStatus.SUBMITTED, ProposalStatus.AWAITING_VERIFICATION,
    ProposalStatus.UNDER_REVIEW, ProposalStatus.CHANGES_REQUESTED, ProposalStatus.REJECTED,
    ProposalStatus.APPROVED, ProposalStatus.SUBMITTED, ProposalStatus.UNDER_REVIEW, ProposalStatus.DRAFT
  ];

  for (let i = 0; i < 10; i++) {
    const catIndex = i % 10;
    await prisma.projectProposal.create({
      data: {
        userId: tedUser.id,
        title: `${categories[catIndex].name} ${projectNouns[i]}`,
        shortDesc: `Proposal for regional ${categories[catIndex].name.toLowerCase()} enhancement.`,
        description: `Full technical implementation plan for ${categories[catIndex].name}. This cause targets systemic issues within the sector using verified procurement and local stakeholder engagement.`,
        categoryId: categories[catIndex].id,
        location: 'Lagos, Nigeria',
        targetAmount: BigInt(500000000 + (i * 20000000)), // 5M to 7M
        status: propStatuses[i],
        submittedAt: subDays(new Date(), i + 2),
        coverImage: stockPhotos[catIndex],
        budgetBreakdown: [{ id: randomUUID(), item: 'Initial Siting', cost: 450000, vendor: 'Surveyor Corps', type: 'SERVICE' }],
        executionTimeline: [{ id: `te-${i}`, phase: 'Inception', estimatedDate: '2026-04-01', deliverables: 'Audit and scoping' }],
      }
    });
  }

  // 7. 20 LIVE PROJECTS (5 Matthew, 15 Admin - No prefixes)
  console.log('🏗️ Seeding 20 Live Projects...');
  const liveProjects = [];
  for (let i = 0; i < 20; i++) {
    const ownerId = i < 5 ? tedUser.id : adminUser.id;
    const catIndex = i % 10;
    const project = await prisma.project.create({
      data: {
        userId: ownerId,
        title: `Regional ${categories[catIndex].name} ${projectNouns[(i + 5) % 10]}`,
        slug: `node-v${i + 1}-${randomUUID().slice(0, 4)}`,
        description: `Strategic operations for ${categories[catIndex].name.toLowerCase()} services in high-density urban corridors.`,
        shortDesc: `Active ${categories[catIndex].name.toLowerCase()} intervention.`,
        targetAmount: BigInt(2500000000 + (i * 100000000)), // 25M to 45M
        raisedAmount: 0n,
        currency: Currency.NGN,
        status: ProjectStatus.ACTIVE,
        categoryId: categories[catIndex].id,
        location: 'Abuja, Nigeria',
        imageUrl: stockPhotos[catIndex],
        executionTimeline: [
          { id: `m1-${i}`, phase: 'Procurement', status: 'COMPLETED', estimatedDate: '2026-02-01', deliverables: 'Hardware verified' },
          { id: `m2-${i}`, phase: 'Site Work', status: 'IN_PROGRESS', estimatedDate: '2026-03-01', deliverables: 'Personnel deployed' }
        ],
        createdAt: subDays(new Date(), 31)
      }
    });
    liveProjects.push(project);
  }

  // 8. 30-DAY LIQUIDITY VELOCITY (₦5,000.00 to ₦450,000.00 Range)
  console.log('📈 Simulating Multi-Million Transactional Throughput...');
  for (let day = 0; day < 30; day++) {
    const date = subDays(new Date(), day);
    const dailyEvents = Math.floor(Math.random() * 6); // Varying frequency

    for (let j = 0; j < dailyEvents; j++) {
      const donorWallet = donorWallets[Math.floor(Math.random() * donorWallets.length)];
      const project = liveProjects[Math.floor(Math.random() * liveProjects.length)];

      // LOGIC: Mix of community small gifts and larger "Impact Grant" figures
      const isLargeGift = Math.random() > 0.8;
      const amount = isLargeGift
        ? BigInt(Math.floor(Math.random() * 40000000) + 5000000) // 50,000 to 450,000
        : BigInt(Math.floor(Math.random() * 1000000) + 500000);   // 5,000 to 15,000

      const reference = `TXN-X-${day}-${j}-${randomUUID().slice(0, 4)}`;

      const walletTx = await prisma.walletTransaction.create({
        data: {
          walletId: donorWallet.id,
          amount,
          currency: Currency.NGN,
          type: TxType.DEBIT,
          status: TxStatus.COMPLETED,
          reference,
          description: `Contribution: ${project.title}`,
          createdAt: date
        }
      });

      await prisma.donation.create({
        data: { userId: donorWallet.userId, projectId: project.id, transactionId: walletTx.id, amount, currency: Currency.NGN, createdAt: date }
      });

      await prisma.project.update({
        where: { id: project.id },
        data: { raisedAmount: { increment: amount } }
      });
    }
  }

  // 9. DISBURSEMENTS (₦4,500,000.00)
  const targetProj = liveProjects[0];
  await prisma.disbursement.create({
    data: {
      projectId: targetProj.id,
      milestoneId: `m1-0`,
      amount: 450000000n,
      currency: Currency.NGN,
      vendorName: 'Continental Engineering Services',
      reference: 'BANK-TRF-V12-01'
    }
  });

  // 10. AUDIT LOGS
  for (let i = 0; i < 30; i++) {
    await prisma.auditLog.create({
      data: {
        userId: adminUser.id,
        action: i % 4 === 0 ? AuditAction.PROJECT_UPDATED : AuditAction.USER_LOGIN,
        entityType: 'SystemNode',
        createdAt: subDays(new Date(), i)
      }
    });
  }

  console.log('\n✨ Optimized Forensic Seed Finalized.');
  console.log('🔑 admin@givar.com / Givartech1$');
  console.log('🔑 tedunjaiyem@gmail.com / Password1');
  console.log('🔑 test@givar.com / Password1');
}

main().catch(e => { console.error(e); process.exit(1); }).finally(async () => { await prisma.$disconnect(); });
