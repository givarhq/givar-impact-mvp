                            className={cn(
                                "p-3 rounded-3xl bg-muted/20 border border-border/40 cursor-pointer hover:bg-muted/40 select-none",
                                expandedCard === 'remaining' ? "col-span-2 border-amber-300/40 bg-amber-50" : "col-span-1"
