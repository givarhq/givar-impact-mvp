                                                        {log.ipAddress}
                                                    </p>
                                                </div>
                                            </div>
                                        </td>
                                        <td className="px-6 py-4">
                                            <Badge variant="outline" className={cn("gap-1.5 px-2.5 py-0.5 rounded-3xl font-bold text-[11px] tracking-tight border-0 shadow-none", style.bg, style.color)}>
