      {/* Category Navigation */}
      <div className="pt-2 w-full min-w-0 overflow-hidden">
        <CategoryBrowser
          categories={categories}
          selected={activeCategory}
          onSelect={setActiveCategory}
        />
      </div>
    </div>
  );
});
