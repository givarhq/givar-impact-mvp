            <ArrowLeft className="mr-2 h-4 w-4 transition-transform group-hover:-translate-x-1" />
            Back to Explore
          </Button>
        </Link>
      </div>

      <div className="w-full min-w-0">
        <ProjectDetailsClient project={project} />
      </div>
    </div>
  );
}
