                                    <div className="shrink-0 flex items-center gap-2">
                                        {isExpanded ? <ChevronDown className="h-4 w-4 text-primary" /> : <ChevronRight className="h-4 w-4 text-muted-foreground/40" />}
                                    </div>
                                </button>

                                <AnimatePresence>
                                    {isExpanded && (
