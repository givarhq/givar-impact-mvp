            </p>
          </div>
        </div>
      )}

      <Card className="rounded-3xl border-border/40 bg-card shadow-sm overflow-hidden">
        <CardContent className="p-5 md:p-8 space-y-8">

          {/* Fixed Identity Type Display */}
