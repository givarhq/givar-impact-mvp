                                </div>
                                {expandedCard === 'remaining' && <X className="h-3 w-3 text-muted-foreground" />}
                            </div>
                            <p className={cn("font-bold text-sm text-amber-700", expandedCard !== 'remaining' && "truncate")}>
                                <SmartCurrency
