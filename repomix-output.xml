const ALL_NAV_ITEMS = [
  { title: 'Overview', href: '/admin', icon: LayoutDashboard },
  { title: 'Projects', href: '/admin/projects', icon: FileText },
  { title: 'Users', href: '/admin/users', icon: Users },
