      </div>

      {/* Balance Display */}
      <div className="relative z-10 mt-4 mb-6">
        <div className="flex items-baseline gap-2">
          <SmartCurrency
            amount={balance}
            currency={currency}
            visible={isVisible}
            size="large"
            className="text-foreground tracking-tight"
          />
