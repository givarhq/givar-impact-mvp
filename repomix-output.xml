                                <Card
                                    className={cn(
                                        "rounded-3xl border shadow-sm transition-all cursor-pointer overflow-hidden md:overflow-visible",
                                        "touch-pan-y select-none",
                                        isSelected ? "border-primary bg-primary/[0.02]" : "border-border/40 bg-card"
