                                </CardHeader>
                                <CardContent className="p-0">
                                    <div className="divide-y divide-border/40">
                                        {timeline.map((phase: any, index: number) => {
                                            const stageItems = budget
                                                .filter((b: any) => (b.stage || 'Main Stage') === phase.phase)
                                                .map((b: any) => b.description || b.item)
