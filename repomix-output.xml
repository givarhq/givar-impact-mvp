                        transition={{ duration: 1, ease: "easeOut" }}
                        className="h-full bg-primary rounded-3xl shadow-sm"
                    />
                </div>
            </div>

            {/* Information Grid */}
            <div className="grid grid-cols-2 gap-3 mb-5 relative">
                <AnimatePresence>
                    {/* Goal Insight */}
                    {(expandedCard === null || expandedCard === 'goal') && (
                        <motion.div
                            layout
                            onClick={() => toggleExpand('goal')}
