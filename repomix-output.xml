      )}>
        <span className="text-xs font-bold tracking-widest text-primary">Budget Total</span>
        <span className="text-xl font-bold text-foreground tabular-nums">₦ {formatNumberInput(String(totalCost))}</span>
      </div>
    </div>
  );
});
