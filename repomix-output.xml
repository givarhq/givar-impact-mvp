                </div>
              </SelectTrigger>
              <SelectContent className="rounded-3xl">
                <SelectItem value="all" className="text-xs">All categories</SelectItem>
                {categories.map(cat => (
                  <SelectItem key={cat.id} value={cat.slug} className="text-xs">{cat.name}</SelectItem>
