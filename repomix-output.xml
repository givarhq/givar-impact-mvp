                    <FinancialTrendChart
                        data={report.financials.recentTrends}
                        title="Liquidity Velocity"
                        subtitle="Volume vs Frequency (30 day trend)"
                    />
                </div>
                <div className="lg:col-span-4">
                    <OrganizationHealthCard metrics={report.organizationMetrics} />
