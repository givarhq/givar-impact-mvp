{
    "name": "@givar/database",
    "version": "0.0.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "prisma generate && tsc",
        "clean": "rm -rf dist",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:push:force": "prisma db push --accept-data-loss",
        "db:studio": "prisma studio",
        "db:seed": "tsx prisma/seed.ts",
        "db:align": "tsx scripts/align-legacy-data.ts",
        "db:migrate-stages": "tsx scripts/migrate-stages.ts",
        "db:clean-slate": "tsx scripts/clean-slate.ts",
        "db:resend-funded": "tsx scripts/resend-funded-emails.ts",
        "dev": "prisma generate --watch"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.2.0",
        "bcrypt": "^5.1.1",
        "date-fns": "^4.1.0",
        "pg": "^8.17.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/node": "^20.0.0",
        "@types/pg": "^8.16.0",
        "dotenv": "^17.2.3",
        "prisma": "^7.2.0",
        "typescript": "^5.0.0"
    },
    "exports": {
        ".": "./dist/index.js"
    }
}