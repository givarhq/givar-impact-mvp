generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------
// ENUMS
// ---------------------------

enum Currency {
  NGN
  USD
  GBP
}

enum TxType {
  DEBIT   // Money leaving a wallet
  CREDIT  // Money entering a wallet
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum SubscriptionInterval {
  WEEKLY
  MONTHLY
}

enum GoalInterval {
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  FUNDED
  COMPLETED
  SUSPENDED
}

enum UpdateType {
  MILESTONE
  ANNOUNCEMENT
  IMPACT_REPORT
}

// ---------------------------
// USER & AUTH
// ---------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  wallets       Wallet[]
  donations     Donation[]
  subscriptions Subscription[]
  givingGoals   GivingGoal[]

  @@map("users")
}

// ---------------------------
// FINANCIAL LEDGER CORE
// ---------------------------

model Wallet {
  id          String    @id @default(uuid())
  userId      String
  currency    Currency
  
  // CAUTION: This is a read-optimization snapshot.
  // The Source of Truth is the sum of WalletTransactions.
  balance     BigInt    @default(0) 
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  user         User                 @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  // Constraint: One wallet per currency per user
  @@unique([userId, currency]) 
  @@map("wallets")
  version     Int       @default(0) // For Optimistic Concurrency Control
}

// The Immutable Ledger
model WalletTransaction {
  id              String    @id @default(uuid())
  walletId        String
  
  // Amounts are always positive absolute values in storage.
  // 'type' determines the arithmetic direction.
  amount          BigInt    
  currency        Currency
  
  type            TxType
  status          TxStatus  @default(PENDING)
  
  reference       String    @unique
  description     String?
  metadata        Json?     // Audit logs (IP, UserAgent)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  wallet      Wallet    @relation(fields: [walletId], references: [id])
  donation    Donation? 

  @@index([walletId])
  @@index([reference])
  @@map("wallet_transactions")
}

// ---------------------------
// GIVAR IMPACT (PROJECTS)
// ---------------------------

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique 
  title       String
  description String  
  shortDesc   String? 
  imageUrl      String?  // Main Hero Image
  gallery       String[] // Array of additional image URLs

  targetAmount BigInt
  raisedAmount BigInt   @default(0)
  currency     Currency
  status        ProjectStatus @default(ACTIVE)

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  tags          String[]  // Simple array for "Urgent", "Verified", etc.

  location      String?   // "Lagos, Nigeria"
  
  updates       ProjectUpdate[]

  donorCount    Int      @default(0)
  endDate       DateTime?
  
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donations    Donation[]
  subscriptions Subscription[]

  @@map("projects")
  @@index([categoryId])
  @@index([status])
}

model ProjectUpdate {
  id          String     @id @default(uuid())
  projectId   String
  title       String
  content     String     @db.Text
  type        UpdateType @default(ANNOUNCEMENT)
  imageUrl    String?
  
  createdAt   DateTime   @default(now())
  
  project     Project    @relation(fields: [projectId], references: [id])

  @@map("project_updates")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique // e.g. "Education", "Health"
  slug        String    @unique
  description String?
  icon        String?   // Lucide icon name or emoji
  
  projects    Project[]

  @@map("categories")
}

model Donation {
  id            String   @id @default(uuid())
  userId        String
  projectId     String
  transactionId String   @unique // Strict link to ledger

  amount        BigInt
  currency      Currency
  message       String?  

  createdAt     DateTime @default(now())

  // Relationships
  user        User              @relation(fields: [userId], references: [id])
  project     Project           @relation(fields: [projectId], references: [id])
  transaction WalletTransaction @relation(fields: [transactionId], references: [id])

  @@map("donations")
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  projectId       String
  
  amount          BigInt   // Amount per interval
  currency        Currency
  interval        SubscriptionInterval
  status          SubscriptionStatus @default(ACTIVE)

  nextChargeDate  DateTime
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  project     Project   @relation(fields: [projectId], references: [id])

  @@map("subscriptions")
}

model GivingGoal {
  id            String       @id @default(uuid())
  userId        String
  
  targetAmount  BigInt
  currency      Currency
  interval      GoalInterval
  status        GoalStatus   @default(ACTIVE)

  startDate     DateTime
  endDate       DateTime
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id])

  // Constraint: A user can only have one active goal of a certain type at a time.
  @@unique([userId, interval, status])
  @@map("giving_goals")
}