generator client {
  provider        = "prisma-client-js"
  engineType      = "library" 
}

datasource db {
  provider = "postgresql"
}

// ---------------------------
// ENUMS
// ---------------------------

enum Currency {
  NGN
  USD
  GBP
}

enum TxType {
  DEBIT   // Money leaving a wallet
  CREDIT  // Money entering a wallet
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum SubscriptionInterval {
  WEEKLY
  MONTHLY
}

enum GoalInterval {
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  FUNDED
  COMPLETED
  SUSPENDED
}

enum UpdateType {
  MILESTONE
  ANNOUNCEMENT
  IMPACT_REPORT
}

enum AuditAction {
  // Auth
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_REGISTER
  PASSWORD_CHANGE
  
  // Financial
  WALLET_FUND
  WALLET_DEBIT
  DONATION_CREATED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_UPDATED
  DIRECT_PAYMENT_INITIATED
  DIRECT_PAYMENT_FULFILLED
  WEBHOOK_SIGNATURE_FAILED
  WALLET_FUND_SUCCESS
  
  // Project/Admin
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  PROJECT_SUSPENDED
  
  // System
  WEBHOOK_RECEIVED
}

enum ProposalStatus {
  DRAFT             // User is still writing
  SUBMITTED         // Locked, waiting for admin
  UNDER_REVIEW      // Admin is actively investigating
  CHANGES_REQUESTED // Sent back to user for edits
  APPROVED          // Promoted to live Project
  REJECTED          // Final decision, dead end
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

// ---------------------------
// USER & AUTH
// ---------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(USER)
  emailVerified         Boolean     @default(false)
  emailVerificationToken String?    @unique
  organization   OrganizationProfile?
  
  refreshTokenHash      String?     @unique
  refreshTokenExpiresAt DateTime?

  failedLoginAttempts   Int         @default(0)
  accountLockedUntil    DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  wallets       Wallet[]
  donations     Donation[]
  subscriptions Subscription[]
  givingGoals   GivingGoal[]
  auditLogs     AuditLog[]
  projectProposals ProjectProposal[]
  projects      Project[]

  @@map("users")
}

// ---------------------------
// FINANCIAL LEDGER CORE
// ---------------------------

model Wallet {
  id          String    @id @default(uuid())
  userId      String
  currency    Currency
  
  // CAUTION: This is a read-optimization snapshot.
  // The Source of Truth is the sum of WalletTransactions.
  balance     BigInt    @default(0) 
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  user         User                 @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  // Constraint: One wallet per currency per user
  @@unique([userId, currency]) 
  @@map("wallets")
  version     Int       @default(0) // For Optimistic Concurrency Control
}

// The Immutable Ledger
model WalletTransaction {
  id              String    @id @default(uuid())
  walletId        String
  
  // Amounts are always positive absolute values in storage.
  // 'type' determines the arithmetic direction.
  amount          BigInt    
  currency        Currency
  
  type            TxType
  status          TxStatus  @default(PENDING)
  
  reference       String    @unique
  description     String?
  metadata        Json?     // Audit logs (IP, UserAgent)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  wallet      Wallet    @relation(fields: [walletId], references: [id])
  donation    Donation? 

  @@index([walletId])
  @@index([reference])
  @@map("wallet_transactions")
}

// ---------------------------
// GIVAR IMPACT (PROJECTS)
// ---------------------------

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique 
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title       String
  description String  
  shortDesc   String? 
  imageUrl      String?  // Main Hero Image
  gallery       Json?    @default("[]")

  targetAmount BigInt
  raisedAmount BigInt   @default(0)
  currency     Currency
  status        ProjectStatus @default(ACTIVE)

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  tags          String[]  // Simple array for "Urgent", "Verified", etc.

  location      String?   // "Lagos, Nigeria"
  
  updates       ProjectUpdate[]

  donorCount    Int      @default(0)
  endDate       DateTime?
  
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donations    Donation[]
  subscriptions Subscription[]
  guestDonations GuestDonation[]

  @@map("projects")
  @@index([categoryId])
  @@index([status])
}

model ProjectUpdate {
  id          String     @id @default(uuid())
  projectId   String
  title       String
  content     String     @db.Text
  type        UpdateType @default(ANNOUNCEMENT)
  imageUrl    String?
  
  createdAt   DateTime   @default(now())
  
  project     Project    @relation(fields: [projectId], references: [id])

  @@map("project_updates")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique // e.g. "Education", "Health"
  slug        String    @unique
  description String?
  icon        String?   // Lucide icon name or emoji
  
  projects    Project[]
  proposals ProjectProposal[]

  @@map("categories")
}

model Donation {
  id            String   @id @default(uuid())
  userId        String?
  projectId     String
  transactionId String   @unique // Strict link to ledger

  amount        BigInt
  currency      Currency
  message       String?  

  createdAt     DateTime @default(now())

  // Relationships
  user        User?              @relation(fields: [userId], references: [id])
  project     Project           @relation(fields: [projectId], references: [id])
  transaction WalletTransaction @relation(fields: [transactionId], references: [id])

  @@map("donations")
}

model GuestDonor {
  id            String          @id @default(uuid())
  email         String          @unique // normalized
  name          String?         
  totalDonated  BigInt          @default(0)
  donationCount Int             @default(0)
  firstDonated  DateTime        @default(now())
  lastDonated   DateTime        @updatedAt

  donations     GuestDonation[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([email])
  @@map("guest_donors")
}

model GuestDonation {
  id            String       @id @default(uuid())
  
  guestDonorId  String
  reference     String       @unique
  projectId     String
  
  amount        BigInt
  currency      Currency
  message       String?
  
  status        TxStatus     @default(COMPLETED)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  guestDonor    GuestDonor   @relation(fields: [guestDonorId], references: [id])
  project       Project      @relation(fields: [projectId], references: [id])

  @@index([guestDonorId])
  @@index([projectId])
  @@index([reference])
  @@map("guest_donations")
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  projectId       String
  
  amount          BigInt   // Amount per interval
  currency        Currency
  interval        SubscriptionInterval
  status          SubscriptionStatus @default(ACTIVE)

  nextChargeDate  DateTime
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  project     Project   @relation(fields: [projectId], references: [id])

  @@map("subscriptions")
}

model GivingGoal {
  id            String       @id @default(uuid())
  userId        String
  
  targetAmount  BigInt
  currency      Currency
  interval      GoalInterval
  status        GoalStatus   @default(ACTIVE)

  startDate     DateTime
  endDate       DateTime
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id])

  // Constraint: A user can only have one active goal of a certain type at a time.
  @@unique([userId, interval, status])
  @@map("giving_goals")
}

model AuditLog {
  id            String      @id @default(uuid())
  userId        String?     // Nullable for system events or failed logins
  action        AuditAction
  
  // Target Resource (What was touched?)
  entityId      String?     
  entityType    String?     // e.g., "Project", "Wallet", "User"
  
  // Context
  metadata      Json?       // Stores { before: ..., after: ... } or details
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime    @default(now())

  // Relationships
  user          User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityId])
  @@map("audit_logs")
}

model ProjectProposal {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])

  // --- 1. The Hook  ---
  title         String?
  shortDesc     String?
  description   String?         @db.Text
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id])
  location      String?
  beneficiaryContact String?
  targetAmount  BigInt?         
  currency      Currency        @default(NGN)

  // --- 2. The Evidence  ---
  coverImage    String?
  gallery       Json?    @default("[]")
  videoUrl      String?

  // --- 3. The Execution Plan ---
  // JSON Structure: 
  // [
  //   { item: "Borehole Drilling", cost: 800000, vendor: "ABC Drilling Ltd", vendorContact: "080...", type: "SERVICE" },
  //   { item: "Water Tank (2000L)", cost: 150000, vendor: "Jumia/Market", type: "GOODS" }
  // ]
  budgetBreakdown Json?
  
  executionTimeline Json?
  riskAnalysis      String?      @db.Text

  // --- 4. The Trust (Identity Only) ---
  // KYC: to verify the Proposer is real and distinct from the Vendors to prevent kickback fraud.
  kycDocuments      String[]     
  organizationName  String?
  contactPhone      String?

  // --- 5. State Machine ---
  status        ProposalStatus  @default(DRAFT)
  adminFeedback String?         @db.Text 
  reviewedBy    String?         
  submittedAt   DateTime?
  approvedAt    DateTime?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@map("project_proposals")
}

model OrganizationProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  
  legalName          String
  registrationNumber String?            // e.g., RC Number
  documentKeys       String[]           // S3 keys for CAC, Tax IDs, etc.
  
  status             VerificationStatus @default(NOT_SUBMITTED)
  adminFeedback      String?            @db.Text
  verifiedAt         DateTime?
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("organization_profiles")
}