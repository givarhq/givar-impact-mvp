generator client {
  provider        = "prisma-client-js"
  engineType      = "library" 
}

datasource db {
  provider = "postgresql"
}

// ---------------------------
// ENUMS
// ---------------------------

enum Currency {
  NGN
  USD
  GBP
}

enum TxType {
  DEBIT   // Money leaving a wallet
  CREDIT  // Money entering a wallet
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  SUSPENSE
}


// Explicit Financial Categories
enum TxCategory {
  FUNDING           // Wallet Top-up
  DONATION          // Money going to a project
  TRANSACTION_FEE   // Mandatory platform fee
  VOLUNTARY_TIP     // Optional donor tip
  DISBURSEMENT      // Payout to vendor
  REFUND            // Returned to donor
  INTERNAL_TRANSFER // Spillover/Suspense movements
  WITHDRAWAL        // User taking money out
  ADJUSTMENT        // Admin correction
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum AccountType {
  INDIVIDUAL
  ORGANIZER
}

enum KycType {
  INDIVIDUAL
  ORGANIZATION
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum SubscriptionInterval {
  WEEKLY
  MONTHLY
}

enum GoalInterval {
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  FUNDED
  COMPLETED
  SUSPENDED
}

enum UpdateType {
  MILESTONE
  ANNOUNCEMENT
  IMPACT_REPORT
  VERIFICATION_UPDATE
  GOAL_ADJUSTMENT
  MILESTONE_UPDATE
  FUNDS_DISBURSED
  IMPACT_ACHIEVED
}

enum AuditAction {
  // Auth
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_REGISTER
  PASSWORD_CHANGE
  RESET_REQUESTED
  RESET_SUCCESSFUL
  ACCOUNT_TYPE_CHANGED
  PROFILE_UPDATED
  AVATAR_UPDATED
  ACCOUNT_DELETED

  // 2FA Actions
  TWO_FACTOR_GEN_SECRET
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_VERIFY_FAILED

  // Security Overrides
  USER_LOCKED
  USER_UNLOCKED
  USER_ROLE_CHANGED
  IMPERSONATION_STARTED
  
  // Financial
  WALLET_FUND
  WALLET_DEBIT
  DONATION_CREATED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_UPDATED
  DIRECT_PAYMENT_INITIATED
  DIRECT_PAYMENT_FULFILLED
  WEBHOOK_SIGNATURE_FAILED
  WALLET_FUND_SUCCESS
  RECONCILIATION_PERFORMED
  FUNDS_MOVED_TO_SUSPENSE
  DISBURSEMENT_RECORDED
  FUNDS_REALLOCATED
  TRANSACTION_RESOLVED
  RECEIPT_VIEWED
  
  // Project/Admin
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  PROJECT_SUSPENDED
  PROPOSAL_REJECTED
  MILESTONE_PROOF_SUBMITTED
  USER_VERIFIED
  USER_REJECTED
  MESSAGE_SENT

  // Amendment System Auditing
  AMENDMENT_REQUESTED
  AMENDMENT_APPROVED
  AMENDMENT_REJECTED
  
  // System
  WEBHOOK_RECEIVED

  // Discovery & Recommendation System
  RECOMMENDATION_CONFIG_UPDATED
  FEATURED_SLOT_CREATED
  FEATURED_SLOT_DELETED
  CATEGORY_WEIGHT_UPDATED
  PROJECT_DISCOVERY_WEIGHTS_UPDATED

  // Fee Governance
  FEE_RULE_CREATED
  FEE_RULE_DEACTIVATED

  // Category Management Actions
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
}

enum ProposalStatus {
  DRAFT             // User is still writing
  SUBMITTED         // Locked, waiting for admin
  AWAITING_VERIFICATION // Waiting for verification
  UNDER_REVIEW      // Admin is actively investigating
  CHANGES_REQUESTED // Sent back to user for edits
  APPROVED          // Promoted to live Project
  REJECTED          // Final decision, dead end
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationStatus {
  APPROVED
  FLAGGED
  HIDDEN
}

enum NotificationType {
  SYSTEM
  MESSAGE
  PROJECT_STATUS
  KYC_STATUS
  PROPOSAL_STATUS
  MILESTONE_ALERT
  DONATION_RECEIVED
}

// ---------------------------
// USER & AUTH
// ---------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(USER)
  avatarKey     String?

  twoFactorSecret  String?   // Encrypted TOTP secret
  twoFactorEnabled Boolean   @default(false)

  preferences      Json?     @default("{}")
  
  emailVerified         Boolean     @default(false)
  emailVerificationToken String?    @unique
  organization   OrganizationProfile?
  accountType   AccountType @default(INDIVIDUAL)
  
  resetPasswordTokenHash String?    @unique
  resetPasswordExpiresAt DateTime?

  failedLoginAttempts   Int         @default(0)
  accountLockedUntil    DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  wallets       Wallet[]
  donations     Donation[]
  subscriptions Subscription[]
  givingGoals   GivingGoal[]
  auditLogs     AuditLog[]
  projectProposals ProjectProposal[]
  projects      Project[]
  sentMessages Message[] @relation("Author")
  notifications Notification[]
  createdFeeRules TransactionFeeRule[]

  @@map("users")
}

// ---------------------------
// FINANCIAL LEDGER CORE
// ---------------------------

model Wallet {
  id          String    @id @default(uuid())
  userId      String
  currency    Currency
  
  // CAUTION: This is a read-optimization snapshot.
  // The Source of Truth is the sum of WalletTransactions.
  balance     BigInt    @default(0) 
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  user         User                 @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  // Constraint: One wallet per currency per user
  @@unique([userId, currency]) 
  @@map("wallets")
  version     Int       @default(0) // For Optimistic Concurrency Control
}

// The Immutable Ledger
model WalletTransaction {
  id              String    @id @default(uuid())
  walletId        String
  
  // Amounts are always positive absolute values in storage.
  // 'type' determines the arithmetic direction.
  amount          BigInt    
  currency        Currency
  
  type            TxType
  status          TxStatus  @default(PENDING)
  category        TxCategory @default(INTERNAL_TRANSFER)
  
  reference       String    @unique
  description     String?
  metadata        Json?     // Audit logs (IP, UserAgent)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  wallet      Wallet    @relation(fields: [walletId], references: [id])
  donation    Donation? 

  @@index([walletId])
  @@index([reference])
  @@index([category])
  @@map("wallet_transactions")
}

// ---------------------------
// GIVAR IMPACT (PROJECTS)
// ---------------------------

model Project {
  id          String   @id @default(uuid())
  proposalId    String?  @unique 
  slug        String   @unique 
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title       String
  description String  
  shortDesc   String? 
  personalMessage String? @db.Text
  imageUrl      String?  // Main Hero Image
  videoUrl      String?
  gallery       Json?    @default("[]")

  targetAmount BigInt
  raisedAmount BigInt   @default(0)
  currency     Currency
  status        ProjectStatus @default(ACTIVE)

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory? @relation("ProjectSubcategory", fields: [subcategoryId], references: [id])

  tags          String[]  // Simple array for "Urgent", "Verified", etc.

  location      String?   // "Lagos, Nigeria"
  
  updates       ProjectUpdate[]

  donorCount    Int      @default(0)
  endDate       DateTime?
  
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  budgetBreakdown   Json?    @default("[]")
  executionTimeline Json?    @default("[]")
  vendors           Json?    @default("[]")
  currentPhaseIndex Int      @default(0)
  waitlistEmails    String[] @default([])
  fundedAt      DateTime?
  riskAnalysis      String?  @db.Text

  beneficiaryName         String?
  beneficiaryAge          Int?
  beneficiaryRelationship String?

  vendorName              String?
  vendorContactPerson     String?
  vendorEmail             String?
  vendorPhone             String?
  vendorAddress           String?

  hasPreCollectedFunds    Boolean  @default(false)
  preCollectedAmount      BigInt?
  preCollectedHeldAt      String?
  preCollectedProofKey    String?
  preCollectedVerified    Boolean  @default(false)

  donations    Donation[]
  subscriptions Subscription[]
  guestDonations GuestDonation[]
  disbursements  Disbursement[]
  milestoneProofs MilestoneProof[]

  moderationStatus  ModerationStatus @default(APPROVED)
  isFeatured        Boolean          @default(false)
  featureWeight     Int              @default(0)
  visibilityScore   Float            @default(0.0)
  featuredSlots     FeaturedSlot[]
  messages Message[]

  @@map("projects")
  @@index([categoryId])
  @@index([status])
}

model ProjectUpdate {
  id          String     @id @default(uuid())
  projectId   String
  title       String
  content     String     @db.Text
  type        UpdateType @default(ANNOUNCEMENT)
  imageUrl    String?
  
  createdAt   DateTime   @default(now())
  
  project     Project    @relation(fields: [projectId], references: [id])

  @@map("project_updates")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique // e.g. "Education", "Health"
  slug        String    @unique
  description String?
  icon        String?   // Lucide icon name or emoji

  visibilityWeight Float  @default(1.0)

  subcategories Subcategory[]
  projects    Project[]
  proposals ProjectProposal[]

  @@map("categories")
}

model Subcategory {
  id          String    @id @default(uuid())
  name        String
  slug        String
  
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  projects    Project[]           @relation("ProjectSubcategory")
  proposals   ProjectProposal[]   @relation("ProposalSubcategory")

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Donation {
  id            String   @id @default(uuid())
  userId        String?
  projectId     String
  transactionId String   @unique // Strict link to ledger

  amount        BigInt   // Total charged to the user
  currency      Currency
  message       String?  

  // Financial Split (Snapshot)
  baseAmount         BigInt    @default(0) // What the project actually receives
  feePercentageUsed  Float     @default(0) // Snapshot of the percentage (e.g., 2.5)
  feeAmount          BigInt    @default(0) // The exact cut taken by platform
  tipAmount          BigInt    @default(0) // Optional donor tip to platform

  createdAt     DateTime @default(now())

  // Relationships
  user        User?              @relation(fields:[userId], references: [id])
  project     Project           @relation(fields: [projectId], references: [id])
  transaction WalletTransaction @relation(fields: [transactionId], references: [id])
  
  feeRuleId          String?
  feeRule            TransactionFeeRule? @relation(fields: [feeRuleId], references: [id])

  @@map("donations")
}

model GuestDonor {
  id            String          @id @default(uuid())
  email         String          @unique // normalized
  name          String?         
  totalDonated  BigInt          @default(0)
  donationCount Int             @default(0)
  firstDonated  DateTime        @default(now())
  lastDonated   DateTime        @updatedAt

  donations     GuestDonation[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([email])
  @@map("guest_donors")
}

model GuestDonation {
  id            String       @id @default(uuid())
  
  guestDonorId  String
  reference     String       @unique
  projectId     String
  
  amount        BigInt       // Total charged to the user
  currency      Currency
  message       String?
  
  // Financial Split (Snapshot)
  baseAmount         BigInt    @default(0)
  feePercentageUsed  Float     @default(0)
  feeAmount          BigInt    @default(0)
  tipAmount          BigInt    @default(0)

  status        TxStatus     @default(COMPLETED)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  guestDonor    GuestDonor   @relation(fields: [guestDonorId], references:[id])
  project       Project      @relation(fields: [projectId], references: [id])

  feeRuleId          String?
  feeRule            TransactionFeeRule? @relation(fields: [feeRuleId], references: [id])

  @@index([guestDonorId])
  @@index([projectId])
  @@index([reference])
  @@map("guest_donations")
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  projectId       String
  
  amount          BigInt   // Amount per interval
  currency        Currency
  interval        SubscriptionInterval
  status          SubscriptionStatus @default(ACTIVE)

  nextChargeDate  DateTime
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  project     Project   @relation(fields: [projectId], references: [id])

  @@map("subscriptions")
}

model GivingGoal {
  id            String       @id @default(uuid())
  userId        String
  
  targetAmount  BigInt
  currency      Currency
  interval      GoalInterval
  status        GoalStatus   @default(ACTIVE)

  startDate     DateTime
  endDate       DateTime
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id])

  // Constraint: A user can only have one active goal of a certain type at a time.
  @@unique([userId, interval, status])
  @@map("giving_goals")
}

model AuditLog {
  id            String      @id @default(uuid())
  userId        String?     // Nullable for system events or failed logins
  action        AuditAction
  
  // Target Resource (What was touched?)
  entityId      String?     
  entityType    String?     // e.g., "Project", "Wallet", "User"
  
  // Context
  metadata      Json?       // Stores { before: ..., after: ... } or details
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime    @default(now())

  // Relationships
  user          User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityId])
  @@map("audit_logs")
}

model ProjectProposal {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])

  // --- 1. The Hook  ---
  title         String?
  shortDesc     String?
  description   String?         @db.Text
  personalMessage String?       @db.Text
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory?    @relation("ProposalSubcategory", fields: [subcategoryId], references: [id])
  location      String?
  endDate       DateTime?
  beneficiaryContact String?
  targetAmount  BigInt?         
  currency      Currency        @default(NGN)

  // --- 2. The Evidence  ---
  coverImage    String?
  gallery       Json?    @default("[]")
  videoUrl      String?

  // --- 3. The Execution Plan ---
  // JSON Structure: 
  // [
  //   { item: "Borehole Drilling", cost: 800000, vendor: "ABC Drilling Ltd", vendorContact: "080...", type: "SERVICE" },
  //   { item: "Water Tank (2000L)", cost: 150000, vendor: "Jumia/Market", type: "GOODS" }
  // ]
  budgetBreakdown Json?
  
  executionTimeline Json?
  vendors           Json?    @default("[]")
  riskAnalysis      String?      @db.Text

  // --- 4. The Trust (Identity Only) ---
  // KYC: to verify the Proposer is real and distinct from the Vendors to prevent kickback fraud.
  kycDocuments      String[]     
  organizationName  String?
  contactPhone      String?

  beneficiaryName         String?
  beneficiaryAge          Int?
  beneficiaryRelationship String?

  vendorName              String?
  vendorContactPerson     String?
  vendorEmail             String?
  vendorPhone             String?
  vendorAddress           String?

  hasPreCollectedFunds    Boolean  @default(false)
  preCollectedAmount      BigInt?
  preCollectedHeldAt      String?
  preCollectedProofKey    String?

  // Admin Operational Signal for Beneficiary Awareness
  awarenessStatus         String?

  // --- 5. State Machine ---
  status        ProposalStatus  @default(DRAFT)
  adminFeedback String?         @db.Text 
  reviewedBy    String?         
  submittedAt   DateTime?
  approvedAt    DateTime?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages Message[]

  @@index([userId])
  @@index([status])
  @@map("project_proposals")
}

model OrganizationProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])

  kycType            KycType            @default(ORGANIZATION)
  
  legalName          String
  registrationNumber String?            // e.g., RC Number
  documentKeys       String[]           // S3 keys for CAC, Tax IDs, etc.
  
  status             VerificationStatus @default(NOT_SUBMITTED)
  adminFeedback      String?            @db.Text
  verifiedAt         DateTime?
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("organization_profiles")
}

model Disbursement {
  id              String   @id @default(uuid())
  projectId       String
  milestoneId     String   // Linked to the phase in executionTimeline
  
  amount          BigInt
  currency        Currency
  vendorName      String
  reference       String   @unique // Internal or Bank Ref
  receiptKey      String?  
  
  createdAt       DateTime @default(now())
  
  project         Project  @relation(fields: [projectId], references: [id])

  @@map("disbursements")
}

model MilestoneProof {
  id            String   @id @default(uuid())
  projectId     String
  milestoneId   String
  
  description   String   @db.Text
  imageKeys     String[] // S3 keys for the proof photos
  
  status        ProofStatus @default(PENDING)
  adminFeedback String?     @db.Text
  
  submittedAt   DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  project       Project  @relation(fields: [projectId], references: [id])

  @@map("milestone_proofs")
}

model RecommendationConfig {
  id                 String   @id @default("default")
  recencyWeight      Float    @default(5.0)
  velocityWeight     Float    @default(7.0)
  engagementWeight   Float    @default(3.0)
  adminWeight        Float    @default(4.0)
  diversityLimit     Int      @default(3)
  showFundedProjects Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  @@map("recommendation_configs")
}

model FeaturedSlot {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  position  Int      @unique
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@map("featured_slots")
}

model Message {
  id          String   @id @default(uuid())
  content     String   @db.Text
  
  // The person who wrote the message
  authorId    String
  author      User     @relation("Author", fields: [authorId], references: [id])
  
  // Context: Is this about a proposal or a live project?
  proposalId  String?
  proposal    ProjectProposal? @relation(fields: [proposalId], references: [id])
  
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])

  // Metadata
  isAdmin     Boolean  @default(false) // Was this sent by Givar Admin?
  isRead      Boolean  @default(false)
  metadata    Json?    @default("{}") // Stores the Funding Amendment Request
  createdAt   DateTime @default(now())

  @@map("messages")
  @@index([proposalId])
  @@index([projectId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      NotificationType
  title     String
  content   String           @db.Text
  link      String?          // The relative path to navigate to when clicked
  
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
  @@index([userId])
  @@index([createdAt])
}

model TransactionFeeRule {
  id                 String    @id @default(uuid())
  percentage         Float     // e.g. 2.5
  appliesGlobally    Boolean   @default(true)
  categoryId         String?   // Overrides global rule for specific sectors
  subcategoryId      String?   // Overrides for specific focus areas
  projectId          String?   // Overrides for an individual project
  optionalTipEnabled Boolean   @default(true)

  activeFrom         DateTime  @default(now())
  activeUntil        DateTime? // Null if currently active

  createdById        String
  creator            User      @relation(fields:[createdById], references: [id])

  isActive           Boolean   @default(true)

  donations          Donation[]
  guestDonations     GuestDonation[]

  @@index([activeFrom, activeUntil])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([projectId])
  @@map("transaction_fee_rules")
}